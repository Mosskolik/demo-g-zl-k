# Bu dosyanın adını ".env" yap ve anahtarını eşittirden sonra yaz.
# .env dosyası .gitignore'da olduğu için GitHub'a YÜKLENMEZ.
GEMINI_API_KEY=buraya_anahtarini_yaz

# İsteğe bağlı ayarlar:
# GEMINI_MODEL=gemini-flash-latest
# AI_PROVIDER=gemini        # gemini | ollama | mock (mock = anahtarsız deneme)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl

# --- Ek ücretsiz sağlayıcılar (isteğe bağlı). Anahtarı yazılan sağlayıcı kendiliğinden devreye girer. ---
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=        # "Workers AI" izni olan token
# CLOUDFLARE_ACCOUNT_ID=
# AI_CHAIN=gemini,groq,mistral,nvidia,cloudflare,openrouter   # denenme sırası
# GROQ_MODELS=...  MISTRAL_MODELS=...  (virgülle birden fazla model)
